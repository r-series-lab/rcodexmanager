{
  "name": "rcodexmanager",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "npm run tauri dev",
    "dev:sh": "sh ./scripts/dev.sh",
    "prebuild": "npm run clean:build-cache",
    "build": "npm run tauri build",
    "manifest:check": "node ./scripts/validate-app-manifest.mjs",
    "manifest:check:json": "node ./scripts/validate-app-manifest.mjs --json",
    "manifest:check:release": "node ./scripts/validate-app-manifest.mjs --release",
    "repo:check": "node ./scripts/check-repository.mjs",
    "repo:check:json": "node ./scripts/check-repository.mjs --json",
    "i18n:check": "node ./scripts/check-i18n-coverage.mjs",
    "release:check": "node ./scripts/release-preflight.mjs",
    "rustfmt:check": "cargo fmt --manifest-path ./src-tauri/Cargo.toml --all -- --check && cargo fmt --manifest-path ./headless-cli/Cargo.toml --all -- --check",
    "check": "npm run manifest:check && npm run repo:check && npm run i18n:check && npm run test:scripts && npm run rustfmt:check && npm run web:test && npm run web:build && npm run rust-test && npm run rust-check && npm run headless:test",
    "build:sh": "sh ./scripts/build.sh",
    "preview": "vite preview",
    "tauri": "tauri",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "web:test": "vitest run",
    "web:test:e2e": "playwright test",
    "test:scripts": "node --test scripts/tests/*.node-test.mjs",
    "rust-check": "cargo check --manifest-path ./src-tauri/Cargo.toml",
    "rust-test": "cargo test --manifest-path ./src-tauri/Cargo.toml",
    "headless:build": "./scripts/build-headless-cli.sh",
    "headless:test": "cargo test --manifest-path ./headless-cli/Cargo.toml",
    "headless:package": "./scripts/package-headless-cli.sh",
    "cli:install": "./scripts/install-local-cli.sh",
    "skill:install": "./scripts/install-skill.sh",
    "screenshots:product": "RCODEXMANAGER_CAPTURE_PRODUCT=1 playwright test e2e/product-screenshots.spec.ts --project=desktop-light",
    "skill:check": "./scripts/install-skill.sh --check",
    "size": "du -sh ./target ./dist 2>/dev/null || true",
    "clean:build-cache": "cargo clean --manifest-path ./src-tauri/Cargo.toml -p rcodexmanager && rm -rf ./dist ./target/release/bundle",
    "clean": "cargo clean --manifest-path ./src-tauri/Cargo.toml && rm -rf ./dist",
    "clean:all": "cargo clean --manifest-path ./src-tauri/Cargo.toml && rm -rf ./dist ./node_modules"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.0.0",
    "@tauri-apps/api": "^2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
