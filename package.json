{
  "name": "rcodexmanager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run tauri dev",
    "dev:sh": "sh ./scripts/dev.sh",
    "prebuild": "npm run clean:build-cache",
    "build": "npm run tauri build",
    "build:sh": "sh ./scripts/build.sh",
    "preview": "vite preview",
    "tauri": "tauri",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "web:test": "vitest run",
    "web:test:e2e": "playwright test",
    "rust-check": "cargo check --manifest-path ./src-tauri/Cargo.toml",
    "rust-test": "cargo test --manifest-path ./src-tauri/Cargo.toml",
    "headless:build": "./scripts/build-headless-cli.sh",
    "headless:test": "cargo test --manifest-path ./headless-cli/Cargo.toml",
    "headless:package": "./scripts/package-headless-cli.sh",
    "skill:install": "./scripts/install-skill.sh",
    "skill:check": "./scripts/install-skill.sh --check",
    "size": "du -sh ./target ./dist 2>/dev/null || true",
    "clean:build-cache": "cargo clean --manifest-path ./src-tauri/Cargo.toml -p rcodexmanager && rm -rf ./dist ./target/release/bundle",
    "clean": "cargo clean --manifest-path ./src-tauri/Cargo.toml && rm -rf ./dist",
    "clean:all": "cargo clean --manifest-path ./src-tauri/Cargo.toml && rm -rf ./dist ./node_modules"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
